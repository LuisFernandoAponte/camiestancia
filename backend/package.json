{
  "name": "laestancia-backend",
  "version": "1.0.0",
  "description": "Backend API for La Estancia - Sistema de Gestión Ganadera",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --import dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "drizzle-kit generate:pg",
    "migrate:push": "drizzle-kit push:pg",
    "migrate:drop": "drizzle-kit drop",
    "seed": "tsx --import dotenv/config src/db/seed.ts",
    "reset-password": "tsx src/reset-password.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest"
  },
  "keywords": [
    "hono",
    "drizzle",
    "postgresql",
    "typescript"
  ],
  "author": "Guayaba Lorente",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.10",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
